# =============================================================================
# Hospital Information System (HIS) Text-to-SQL — Environment Configuration
# Copy this file to .env and replace the placeholder values.
# =============================================================================

# -----------------------------------------------------------------------------
# Hospital Replica Database (Read-Only Target for Generated SQL)
# -----------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=his_db
PG_USER=his_readonly
PG_PASSWORD=replace_with_readonly_password

# -----------------------------------------------------------------------------
# dbt Runner Database (User with DDL/CREATE TABLE permissions in dbt_analytics)
# -----------------------------------------------------------------------------
DBT_PG_HOST=localhost
DBT_PG_PORT=5432
DBT_PG_DBNAME=his_db
DBT_PG_USER=dbt_user
DBT_PG_PASSWORD=replace_with_dbt_password
DBT_READONLY_ROLE=his_readonly

# Timezone for container and daily incremental batch scheduling (e.g., UTC, America/New_York)
TZ=UTC

# -----------------------------------------------------------------------------
# RAG & Query Settings
# -----------------------------------------------------------------------------
MAX_CONTEXT_ITEMS=10
MAX_RESULT_ROWS=200
MAX_FULL_DDL=12
MAX_SUMMARY_DDL=20
MAX_HISTORY_TURNS=10

# Automatically embed schema and dbt documentation into ChromaDB on startup
SEED_ON_STARTUP=true
AUTO_TRAIN_ON_STARTUP=false

# -----------------------------------------------------------------------------
# LLM — Dual-Brain Architecture (vLLM Endpoints)
# -----------------------------------------------------------------------------
# Big Brain: Complex reasoning, query rewriting, and SQL generation (e.g. 31B+ parameter model)
VLLM_BIG_BRAIN_BASE_URL=http://your-gpu-server-1:8000/v1
VLLM_BIG_BRAIN_MODEL=gemma-4-31B-it
VLLM_BIG_BRAIN_TEMPERATURE=0.1
VLLM_BIG_BRAIN_TOP_P=0.95
VLLM_BIG_BRAIN_TOP_K=64
VLLM_BIG_BRAIN_API_KEY=sk-your-big-brain-key

# Small Brain: Fast intent classification, UI formatting, and chart generation (e.g. 4B-9B parameter model)
VLLM_SMALL_BRAIN_BASE_URL=http://your-gpu-server-2:8000/v1
VLLM_SMALL_BRAIN_MODEL=gemma-4-E4B-it
VLLM_SMALL_BRAIN_TEMPERATURE=1.0
VLLM_SMALL_BRAIN_TOP_P=0.95
VLLM_SMALL_BRAIN_TOP_K=64
VLLM_SMALL_BRAIN_API_KEY=sk-your-small-brain-key

# -----------------------------------------------------------------------------
# Chainlit Application & Application State Database
# -----------------------------------------------------------------------------
# Generate secret using: chainlit create-secret
CHAINLIT_AUTH_SECRET=generate_with_chainlit_create_secret

# Dedicated PostgreSQL instance for Chainlit sessions, user auth, and query feedback
CHAINLIT_DB_HOST=chainlit-db
CHAINLIT_DB_PORT=5432
CHAINLIT_DB_USER=chainlit
CHAINLIT_DB_PASSWORD=choose_a_secure_password
CHAINLIT_DB_NAME=chainlit

# -----------------------------------------------------------------------------
# Observability & Debugging
# -----------------------------------------------------------------------------
DEBUG_CHAT=false
LOG_LEVEL=INFO
